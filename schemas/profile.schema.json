{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quivra profile",
  "type": "object",
  "properties": {
    "version": {
      "description": "Format version of this profile.",
      "type": "integer",
      "const": 1
    },
    "$schema": {
      "description": "Optional editor schema reference.",
      "type": "string",
      "default": ""
    },
    "files": {
      "description": "Output paths mapped to template paths relative to this profile.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
      }
    },
    "modelFiles": {
      "description": "Templates for individual TypeScript models, by model kind.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ModelFiles"
      }
    },
    "serviceFiles": {
      "description": "Templates for individual OpenAPI services.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ServiceFiles"
      }
    },
    "batchFiles": {
      "description": "Output paths and templates for files written at the batch root.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
      },
      "default": {},
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
      }
    },
    "typescript": {
      "description": "Settings for projecting OpenAPI into the template context.",
      "allOf": [
        {
          "$ref": "#/definitions/ProjectionOptions"
        }
      ]
    },
    "options": {
      "description": "Project-defined JSON values exposed to templates as options.",
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "files"
  ],
  "anyOf": [
    {
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "files"
      ]
    },
    {
      "properties": {
        "modelFiles": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "modelFiles"
      ]
    },
    {
      "properties": {
        "serviceFiles": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "serviceFiles"
      ]
    }
  ],
  "definitions": {
    "ModelFiles": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/ModelKind"
        },
        "directory": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
        },
        "template": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "directory",
        "template"
      ]
    },
    "ModelKind": {
      "type": "string",
      "enum": [
        "interface",
        "type",
        "enum"
      ]
    },
    "ServiceFiles": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
        },
        "template": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]/)*[A-Za-z0-9_.$-]*[A-Za-z0-9_$-]$"
        },
        "suffix": {
          "description": "Suffix appended to the generated service name.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_$]*$",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "directory",
        "template"
      ]
    },
    "ProjectionOptions": {
      "type": "object",
      "properties": {
        "interfacePrefix": {
          "description": "Prefix for generated interface names and references.",
          "type": "string",
          "default": ""
        },
        "typeAliasPrefix": {
          "description": "Prefix for generated type alias names and references.",
          "type": "string",
          "default": ""
        },
        "ignoreUnusedModels": {
          "description": "Keep only models reachable from operations.",
          "type": "boolean",
          "default": false
        },
        "excludeDeprecatedOperations": {
          "description": "Omit deprecated operations and query parameters.",
          "type": "boolean",
          "default": false
        },
        "preserveNullableAnnotations": {
          "description": "Keep explicit OpenAPI 3.0 nullable annotations in the projection.",
          "type": "boolean",
          "default": false
        },
        "broadHttp": {
          "description": "Include extra HTTP parameter and media types for templates to handle.",
          "type": "boolean",
          "default": false
        },
        "enumObjects": {
          "description": "Expose eligible named enums as enum models.",
          "type": "boolean",
          "default": false
        },
        "objectIndexInterfaces": {
          "description": "Keep object models with additional properties as interfaces with index signatures.",
          "type": "boolean",
          "default": false
        },
        "stripServiceTagSuffix": {
          "description": "Remove this exact suffix from OpenAPI tags when deriving service names.",
          "type": "string",
          "default": ""
        },
        "runtimeContracts": {
          "description": "Project validation schemas and actions for components marked x-assistant-action.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  }
}
