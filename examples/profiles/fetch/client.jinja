// {{ options.header }} · generated by Quivra.
{% for model in models -%}
export interface {{ model.name }} {
{% for field in model.fields -%}
    {{ field.name | ts_string }}{% if field.optional %}?{% endif %}: {{ field.type }};
{% endfor -%}
}
{% endfor -%}
export interface FetchOptions {
    baseUrl: string;
    fetch?: typeof globalThis.fetch;
}
{% for operation in operations -%}
export async function {{ operation.id }}(
    options: FetchOptions,
{% if operation.path_parameters or operation.query_parameters or operation.body_type -%}
    input: {
{% if operation.path_parameters -%}
        path: {
{% for parameter in operation.path_parameters -%}
            {{ parameter.name | ts_string }}: {{ parameter.type }};
{% endfor -%}
        };
{% endif -%}
{% if operation.query_parameters -%}
        query: {
{% for parameter in operation.query_parameters -%}
            {{ parameter.name | ts_string }}{% if parameter.optional %}?{% endif %}: {{ parameter.type }};
{% endfor -%}
        };
{% endif -%}
{% if operation.body_type -%}
        body: {{ operation.body_type }};
{% endif -%}
    },
{% endif -%}
): Promise<{{ operation.response_type }}> {
    const path = {{ operation.path | ts_string }}{% for parameter in operation.path_parameters %}
        .replaceAll({{ ("{" ~ parameter.name ~ "}") | ts_string }}, encodeURIComponent(String(input.path[{{ parameter.name | ts_string }}]))){% endfor %};
    const base = options.baseUrl.replace(/\/$/, "");
{% if operation.query_parameters -%}
    const query = new URLSearchParams();
{% for parameter in operation.query_parameters -%}
    if (input.query[{{ parameter.name | ts_string }}] !== undefined) {
        query.set({{ parameter.name | ts_string }}, String(input.query[{{ parameter.name | ts_string }}]));
    }
{% endfor -%}
    const url = base + path + (query.size ? "?" + query : "");
{% else -%}
    const url = base + path;
{% endif -%}
    const send = options.fetch ?? globalThis.fetch;
    const response = await send(url, {
        method: {{ operation.method | ts_string }},
{% if operation.body_type -%}
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(input.body),
{% endif -%}
    });

    if (!response.ok) {
        throw new Error({{ operation.method | ts_string }} + " " + path + " returned HTTP " + response.status);
    }
{% if operation.response_type != "void" -%}
    return await response.json() as {{ operation.response_type }};
{% endif -%}
}
{% endfor -%}
