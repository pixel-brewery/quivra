{% if model.imports %}
// #region Imports

{% for dependency in model.imports -%}
import type { {{ dependency.name }} } from '{% if dependency.is_type_alias %}../types/{% else %}./{% endif %}{{ dependency.name }}.js';
{% endfor %}
// #endregion
{% endif %}
export interface {{ model.name }} {
{% for field in model.fields -%}
    readonly {{ field.name | ts_string }}{% if field.optional %}?{% endif %}: {{ field.type }};
{% endfor -%}
}
