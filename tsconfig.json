{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": [".github/scripts/**/*.ts", "distribution/*.ts", "distribution/npm/**/*.ts", "examples/smoke.ts"],
  "exclude": ["distribution/npm-api.types.ts", "distribution/smoke.ts"]
}
